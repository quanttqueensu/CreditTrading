# Copy to deploy/ibgw/.env and fill in. That file is gitignored; this one is not.
#
#   cp deploy/ibgw/.env.example deploy/ibgw/.env
#
# These are IBKR login credentials. They are not the same thing as the API
# settings in config/.env — that file says WHERE to connect, this one says WHO
# to log in as. Keep them separate and keep both out of git.

TWS_USERID=
TWS_PASSWORD=

# paper | live.  Leave this as paper. See the note in docker-compose.yml.
TRADING_MODE=paper

# Daily gateway restart. Must sit clear of the trading window — the CEF book
# decides at 17:15 ET, benchmarks at 17:25.
AUTO_RESTART_TIME=03:00 AM
TIME_ZONE=America/New_York

# What IBC does when a 2FA prompt times out. `restart` retries the login.
TWOFA_TIMEOUT_ACTION=restart
