        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/simonjarvis/Desktop/QUANTT/2027/ops/schedule/run_weekly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/simonjarvis/Desktop/QUANTT/2027</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHON</key>
        <string>/opt/anaconda3/bin/python3</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/simonjarvis/Desktop/QUANTT/2027/ops/schedule/logs/launchd_weekly.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/simonjarvis/Desktop/QUANTT/2027/ops/schedule/logs/launchd_weekly.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
