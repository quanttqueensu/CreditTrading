# Human-owned knobs for the EVENING half of the cef schedule (added 2026-09-11).
#
# WHAT THIS JOB IS FOR, IN ORDER OF IMPORTANCE
#   1. CAPTURE. `ib.fills()` serves the current TWS session only and the 03:00
#      restart empties it, so a fill not captured the same evening is gone. On
#      2026-09-10 four MOC orders filled at the close and their executions were
#      lost exactly this way: the session that would have captured them was
#      still asleep and did not run capture until 10:38 the next morning. The
#      positions survived (arm() re-adopted them from the broker); the slippage
#      rows did not, and cannot be reconstructed.
#   2. PANEL. It writes tonight's price/NAV pair, which is what the 08:30
#      session reads tomorrow. It does NOT require the pair to be complete --
#      the pair typically completes at ~21:45, four hours after this fires, and
#      the morning fetches it again against a published number.
#   3. FALLBACK DECISION, only if no cef session armed today. That is the old
#      2026-09-08 evening behaviour, kept because it is the thing that trades
#      when the morning could not. ops/session_plan.py decides which of these
#      three this fire is; it is not configurable here.
#
# RUNG LADDER — raise ONE rung at a time, each a deliberate human edit:
#   RUNG-0  DRY_RUN=1  EXECUTION=simulator   compute + log targets only
#   RUNG-1  DRY_RUN=0  EXECUTION=simulator   live shadow ledger, no orders sent
#   RUNG-2  DRY_RUN=0  EXECUTION=ibkr        real orders to the IBKR PAPER account
#
# CURRENT RUNG: RUNG-0. DELIBERATE, and it must stay here until the human has
# watched one full morning cycle arm and fill. At RUNG-0 this job still does
# duty 1 and duty 2 in full -- capture is outside the DRY_RUN gate in
# launch_job.py phase 4, and the refresh never depended on it -- and only the
# fallback decision is withheld. That is the ordering that makes this safe to
# install before the morning job has ever run: the evening can only record and
# fetch, so the two jobs cannot both decide while the schedule is being proved.
DRY_RUN=1
EXECUTION=ibkr

# 48. cef=45, benchmarks=46, phase0=47 (see each .env). The derived ids stay
# clear too: capture_fills uses id+50 = 98, preflight id+60 = 108,
# reconcile_orders id+70 = 118, none of which collide with 95/96/97, 105/106/107
# or 115/116/117. IB allows ONE session per id and the second connect evicts the
# first, which then reports a dead broker -- so an id collision looks exactly
# like a gateway outage. Inventory: docs/INFRASTRUCTURE.md 6.2.
IBKR_CLIENT_ID=48

# The fallback decision's NAV wait, used ONLY when this job is deciding. The
# deadline is the same 23:30 the single evening session used, for the same
# reason: measured completions are 22:43 (2026-09-08) and 21:45 (2026-09-09),
# and 23:30 still leaves the 03:00 gateway restart clear.
NAV_DEADLINE=23:30
NAV_POLL_SECONDS=900
NAV_WAIT_EXTRA=--no-cefconnect

# BOOK / BOOKS_ROOT deliberately absent — same reason as every other job env:
# the launchd entry point derives them from its own REPO so paths follow the
# tree the code runs from, and an absolute path here would make the manual
# wrapper write to a different ledger than the scheduled job.
