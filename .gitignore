# Credentials — never commit. Alpaca keys: ALPACA_<BOOK>_KEY_ID / _SECRET_KEY.
config/.env
config/.env.*
.env

# Market data (gigabytes). Rebuilt by the fetchers in scripts/cef/.
# LEADING SLASH IS LOAD-BEARING: a bare `data/` would also match any src/**/data/.
/data/

# Caches and scratch
**/__pycache__/
*.pyc
.pytest_cache/
results/**/_cache_*
.ipynb_checkpoints/
*.log

# macOS
.DS_Store

# Runtime halt/heartbeat records (ops/halt.py). Written inside the prod clone at
# run time; untracked so a (cleared) halt never blocks the installer's clean-tree
# check. The runner reads the halt at run time, so ignoring it here cannot let a
# standing halt be skipped.
/ops/HALT*.md
/ops/halts/
/ops/heartbeat.json

# Background agents' git worktrees (Claude Code); second copies of the repo.
/.claude/worktrees/

# Row-level tables derived from licensed WRDS data (CRSP, TRACE): permnos, CUSIPs,
# delisting records and per-event returns. This repository is public, so they stay
# on disk only; the scripts named in results/events/REPRO_*_2026-10-11.md rebuild
# them. Aggregates (*_summary.json, run logs, per-fund beta tables) are tracked.
results/events/merger_events_2010_2022.csv
results/events/merger_pairs_fixed_offset.csv
results/events/merger_acquirers_2010_2022.csv
results/events/merger_ann_sample.csv
results/events/alpaca_acquirers_2026-10-11.csv
results/events/term_pull_to_par_measure.csv
results/events/term_cef_census.csv
results/events/convert_issuance_events.csv
