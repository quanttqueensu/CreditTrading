# Credentials — never commit. See docs/INFRASTRUCTURE.md for the required keys.
# The glob matters: ops/switch_broker.py writes config/.env.switch_broker.bak,
# which is a byte copy of config/.env and therefore carries the same secrets.
config/.env
config/.env.*
.env
deploy/ibgw/.env

# Market data (3.8 GB). Rebuilt with the scripts in scripts/fetch/.
# See docs/INFRASTRUCTURE.md section "Rebuilding the data folder".
# LEADING SLASH IS LOAD-BEARING (fixed 2026-09-10): a bare `data/` also
# matched src/data/, silently untracking r2.py and __init__.py, and would
# swallow any future src/**/data/ module the same way.
/data/

# Caches and scratch
**/__pycache__/
*.pyc
.pytest_cache/
results/**/_cache_*
.ipynb_checkpoints/

# macOS
.DS_Store

# Live broker state — machine-specific, regenerated each session
ops/books/**/_desync/
ops/logs/
*.log
