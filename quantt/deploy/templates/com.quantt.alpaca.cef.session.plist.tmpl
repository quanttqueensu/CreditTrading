<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.quantt.alpaca.cef.session : the CEF book's trading session on Alpaca paper.

  RENDERED by quantt/deploy/install_prod.py from release tag ${TAG}. Do not
  hand-edit the installed copy: re-run the installer (docs/RUNBOOK.md). The
  installer re-checks every key below after rendering, so an edit here that
  changes the command, the schedule or the environment keys fails the install.

  Schedule: every 30 minutes (:00 and :30), every day, in scheduled mode (run.py `scheduled`).
  The RUNNER decides whether a firing is a slot to try in (evening 22:00-01:00
  ET after the as-of close, when that day's NAVs are in; morning 06:00-15:15
  ET on the session date as the backstop; team lead 2026-09-29) and whether
  the session is already done; any other firing prints one IDLE line and
  exits 5 without touching the broker's order endpoints. Local time must be
  US/Eastern (the installer refuses otherwise). launchd runs a missed
  interval once on wake; the runner's clock gate (19:15 ET on the as-of date
  to 15:45 ET on the session date) is what stops a late wake from trading,
  and gate 6 refuses a second set for the same auction (docs/RUNNER.md).

  DRY_RUN is "1" unless the installer was given armed mode. The runner transmits only
  when DRY_RUN is exactly "0" AND it is armed (docs/RUNNER.md gate 2).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.quantt.alpaca.cef.session</string>
	<key>ProgramArguments</key>
	<array>
		<string>${PYTHON}</string>
		<string>-m</string>
		<string>quantt.session</string>
		<string>run</string>
		<string>--book</string>
		<string>cef</string>
		<string>--scheduled</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${PROD_DIR}</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DRY_RUN</key>
		<string>${DRY_RUN}</string>
		<key>QUANTT_STATE_DIR</key>
		<string>${STATE_DIR}</string>
		<key>QUANTT_ENV_FILE</key>
		<string>${ENV_FILE}</string>
		<key>PATH</key>
		<string>${PATH}</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Minute</key><integer>0</integer></dict>
		<dict><key>Minute</key><integer>30</integer></dict>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>${LOG_DIR}/session.out.log</string>
	<key>StandardErrorPath</key>
	<string>${LOG_DIR}/session.err.log</string>
</dict>
</plist>
