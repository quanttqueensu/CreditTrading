# quantt-c4-secret.service : C4's Alpaca keys, from the cloud secret store into
# ${ENV_FILE} (tmpfs): once per boot when the fetch succeeds.
#
# RENDERED by quantt/deploy/install_vm.py --book c4 from release tag ${TAG}. Do
# not hand-edit the installed copy: re-run the installer (docs/RUNBOOK.md
# section 8). The installer re-checks every key below after rendering.
#
# C4 trades its OWN Alpaca paper account (team lead 2026-10-26), so its keys are
# its own secrets (alpaca-c4-key-id, alpaca-c4-secret-key, which the team lead
# creates in the vault) in its own directory: RuntimeDirectory=quantt-c4 makes
# /run/quantt-c4, owned by User=/Group=, mode 0700, apart from the core's
# /run/quantt. The core's key file never holds C4's keys, nor the other way
# round, and restarting one book's key service never removes the other's file.
# Everything else is quantt-secret.service's design (see that template and
# install_vm.py, THE KEY FILE): RemainAfterExit=yes, re-fetched at every
# installer --apply while C4's timers are stopped, pulled in by C4's job units
# with Wants= + After=, never Requires=.
[Unit]
Description=QUANTT C4 Alpaca keys into /run/quantt-c4 (release ${TAG})
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=${USER}
Group=${USER}
RuntimeDirectory=quantt-c4
RuntimeDirectoryMode=0700
WorkingDirectory=${PROD_DIR}
Environment=PATH=${PATH}
Environment=PYTHONUNBUFFERED=1
ExecStart=${PYTHON} -m quantt.deploy.boot_secrets --provider azure-keyvault --config vault=${VAULT} --secret alpaca-c4-key-id=ALPACA_C4_KEY_ID --secret alpaca-c4-secret-key=ALPACA_C4_SECRET_KEY --out ${ENV_FILE}
StandardOutput=append:${LOG_DIR}/secret.out.log
StandardError=append:${LOG_DIR}/secret.err.log

[Install]
WantedBy=multi-user.target
