# quantt-secret.service : the Alpaca keys, from the cloud secret store into
# ${ENV_FILE} (tmpfs): once per boot when the fetch succeeds.
#
# RENDERED by quantt/deploy/install_vm.py from release tag ${TAG}. Do not
# hand-edit the installed copy: re-run the installer (docs/RUNBOOK.md section 8).
# The installer re-checks every key below after rendering, so an edit here that
# changes the command, the user or the directory fails the install.
#
# RuntimeDirectory=quantt makes /run/quantt, owned by User=/Group=, mode 0700.
# /run is a tmpfs, so our code never writes the key file to disk. The kernel can
# still page memory to the swap file bootstrap.sh creates (/swapfile, not
# encrypted by us; Azure managed disks are encrypted at rest by default [S: Azure
# docs, not re-read]). The directory, and the keys with it, is removed when this
# service stops (systemd.exec(5)).
# RemainAfterExit=yes keeps the service active after a SUCCESSFUL fetch, so the
# directory lives until shutdown and the fetch runs once per boot (and again at
# every installer --apply, which restarts this service while the timers are
# stopped, so the keys match the unit just loaded). A FAILED fetch
# leaves it inactive, and every job start pulls it in again: self-healing, but
# each job waits up to about 4 minutes when every request times out (the retry
# schedule is in quantt/deploy/boot_secrets.py). The job units pull this in with
# Wants= + After=, never Requires= (see install_vm.py, THE KEY FILE).
# Provider-specific code lives only in quantt/deploy/azure_keyvault.py, reached
# through boot_secrets --provider.
[Unit]
Description=QUANTT Alpaca keys into /run/quantt (release ${TAG})
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=${USER}
Group=${USER}
RuntimeDirectory=quantt
RuntimeDirectoryMode=0700
WorkingDirectory=${PROD_DIR}
Environment=PATH=${PATH}
Environment=PYTHONUNBUFFERED=1
ExecStart=${PYTHON} -m quantt.deploy.boot_secrets --provider azure-keyvault --config vault=${VAULT} --secret alpaca-cef-key-id=ALPACA_CEF_KEY_ID --secret alpaca-cef-secret-key=ALPACA_CEF_SECRET_KEY --out ${ENV_FILE}
StandardOutput=append:${LOG_DIR}/secret.out.log
StandardError=append:${LOG_DIR}/secret.err.log

[Install]
WantedBy=multi-user.target
