# quantt-reports-secret.service : the ACT push's SMTP settings, from the vault into
# ${ENV_FILE} (tmpfs).
#
# RENDERED by quantt/deploy/install_vm.py --reports from release tag ${TAG}. Do not
# hand-edit the installed copy.
#
# THE TWO SECRETS (alert-smtp-user, alert-smtp-pass) ARE THE TEAM LEAD'S TO CREATE
# (docs/RUNBOOK.md 8.11). Until they exist this unit fails on each try, and that is
# all: the risk units reach it through Wants= (never Requires=), so a fired stop
# still runs, cannot deliver, and exits non-zero with
# `ACT: notification NOT delivered`. It holds no Alpaca key and is never pulled in
# by a session, verify or collect unit.
[Unit]
Description=QUANTT report alert settings into /run/quantt-reports (release ${TAG})
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=${USER}
Group=${USER}
RuntimeDirectory=${RUNTIME_DIR}
RuntimeDirectoryMode=0700
WorkingDirectory=${PROD_DIR}
Environment=PATH=${PATH}
Environment=PYTHONUNBUFFERED=1
ExecStart=${PYTHON} -m quantt.deploy.boot_secrets --provider azure-keyvault --config vault=${VAULT} --secret alert-smtp-user=ALERT_SMTP_USER --secret alert-smtp-pass=ALERT_SMTP_PASS --out ${ENV_FILE}
StandardOutput=append:${LOG_DIR}/reports-secret.out.log
StandardError=append:${LOG_DIR}/reports-secret.err.log

[Install]
WantedBy=multi-user.target
