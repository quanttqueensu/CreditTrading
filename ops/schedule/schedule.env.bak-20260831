# Human-owned knobs for the scheduled book (v2). Sourced by run_after_close.sh /
# run_weekly.sh. Everything here is SIMULATOR — no real orders are ever sent.
#
# THE RUNG LADDER (raise one rung at a time; each is a deliberate human edit):
#   RUNG-0  DRY_RUN=1  EXECUTION=simulator  -> wrapper computes + LOGS the target
#                                              book into a throwaway dir; the live
#                                              book_status_v2.json is never touched.
#   RUNG-2  DRY_RUN=0  EXECUTION=simulator  -> the LIVE simulator book advances each
#           (CURRENT)                          trading day and marks to yfinance EOD.
#                                              This is the pre-registered OOS paper
#                                              record (PAPER_PREREG.md, snapshot
#                                              2026-07-24). Still no real orders.
#   RUNG-3  DRY_RUN=0  EXECUTION=ibkr        -> the SAME netted book is forwarded to
#                                              the IBKR *paper* account for fill/
#                                              spread realism (needs IB Gateway up;
#                                              creds/host/port in config/.env, not
#                                              here). Requires a separate sign-off.
#
# CURRENT RUNG: RUNG-2 (live simulator OOS paper record).

DRY_RUN=0
EXECUTION=simulator
