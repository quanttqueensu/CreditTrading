<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quantt.book.weekly</string>

    <!-- Saturday __WHOUR__:__WMINUTE__ local time: the weekly book report. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>__WHOUR__</integer><key>Minute</key><integer>__WMINUTE__</integer></dict>
    </array>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/ops/schedule/run_weekly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHON</key>
        <string>__PYTHON__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO__/ops/schedule/logs/launchd_weekly.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/ops/schedule/logs/launchd_weekly.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
